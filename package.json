{
  "name": "aca-agent",
  "version": "0.1.0",
  "description": "Agente de Reparação de Aplicativos - núcleo (scaffold)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "vitest run",
    "prepare": "",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "agent",
    "automation",
    "aca"
  ],
  "author": "davibcv",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "node-fetch": "^3.3.2",
    "typescript": "^5.2.2",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=20"
  }
}
